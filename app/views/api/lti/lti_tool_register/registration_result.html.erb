<!-- app/views/lti/dynamic_registrations/registration_result.html.erb -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>LTI Dynamic Registration Result</title>
  <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif; margin: 2rem; }
      code { background: #f5f5f5; padding: .1rem .3rem; border-radius: 3px; }
  </style>
</head>
<body>
<% if @client_id.present? %>
  <h2>登録を完了しました</h2>
  <p><strong>client_id</strong>: <code><%= @client_id %></code></p>
  <% if @deployment_id.present? %>
    <p><strong>deployment_id</strong>: <code><%= @deployment_id %></code></p>
  <% end %>
  <p>Canvas の確認画面に戻ります。権限・配置を確認してから有効化してください。</p>
  <script>
    (function notifyDynRegComplete() {
      var canvasPayload = { subject: "org.imsglobal.lti.close" };
      var moodlePayload = { type: "lti.dynreg.complete", ok: true };

      var targetOrigin = (function() {
        try {
          if (document.referrer) {
            return new URL(document.referrer).origin;
          }
        } catch(e) {}
        return "*";
      })();

      function postOnce() {
        var sent = false;
        var targets = [];
        if (window.parent && window.parent !== window) {
          targets.push(window.parent);
        }
        if (window.top && window.top !== window && window.top !== window.parent) {
          targets.push(window.top);
        }
        if (window.opener && !window.opener.closed) {
          targets.push(window.opener);
        }
        var i;
        for (i = 0; i < targets.length; i++) {
          try {
            targets[i].postMessage(canvasPayload, "*");
            targets[i].postMessage(canvasPayload, targetOrigin);
            targets[i].postMessage(moodlePayload, targetOrigin);
            sent = true;
          } catch(e) {
            console.warn("postMessage failed:", e);
          }
        }
        console.log("[dynreg] postMessage sent?", sent, "targetOrigin=", targetOrigin);
        return sent;
      }

      var ok = postOnce();
      var retries = 30;
      var timer = setInterval(function() {
        if (ok || --retries <= 0) {
          clearInterval(timer);
          return;
        }
        ok = postOnce();
      }, 100);
    })();
  </script>
<% else %>
  <h2>登録に失敗しました。</h2>
  <pre><%= @error_message.to_s %></pre>
  <script>
    try {
      if (window.parent && window.parent !== window) {
        window.parent.postMessage({ subject: "org.imsglobal.lti.close" }, "*");
      }
    } catch(e) {}
  </script>
<% end %>
</body>
</html>
